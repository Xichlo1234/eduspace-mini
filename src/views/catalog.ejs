<div class="page-head"><h1>Phòng học</h1></div>
<%- include('partials/settings_tabs') %>
<div class="grid">
<div class="card"><h2>Phòng học</h2><p class="hint">Chỉ cần khai báo nếu trung tâm có nhiều phòng – dùng để phát hiện trùng phòng.</p>
<ul class="list-plain"><% for (const r of rooms) { %><li><form method="post" action="/settings/rooms" class="row" style="width:100%"><%- include('partials/csrf') %><input type="hidden" name="id" value="<%= r.id %>">
  <div class="field" style="flex:2 1 120px"><input name="name" value="<%= r.name %>"></div><div class="field" style="flex:1 1 80px"><input type="number" name="capacity" value="<%= r.capacity || '' %>" placeholder="Sức chứa"></div>
  <div class="field"><select name="active"><option value="1" <%= r.active ? 'selected' : '' %>>Đang dùng</option><option value="0" <%= !r.active ? 'selected' : '' %>>Ngừng</option></select></div><button class="btn sm">Lưu</button></form></li><% } %></ul>
<form method="post" action="/settings/rooms" class="row" style="margin-top:10px"><%- include('partials/csrf') %><div class="field"><label>Thêm phòng</label><input name="name" required placeholder="VD: P.101"></div><div class="field"><label>Sức chứa</label><input type="number" name="capacity"></div><button class="btn primary">Thêm</button></form></div>
</div>
