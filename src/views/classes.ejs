<div class="page-head"><div><h1><%= isTeacher ? 'Lớp của tôi' : 'Lớp học' %></h1></div>
  <div class="actions"><% if (can.manageClasses) { %><a class="btn primary" href="/classes/new">+ Tạo lớp</a><% } %><a class="btn" href="/schedule">📅 Lịch tuần</a>
  <% if (can.manageClasses) { %><a class="btn" href="/settings/holidays">Ngày nghỉ</a><% } %></div></div>
<div class="tabs"><% for (const [k, v] of Object.entries({ active: 'Đang hoạt động', finished: 'Đã kết thúc', all: 'Tất cả' })) { %><a class="<%= status === k ? 'active' : '' %>" href="?status=<%= k %>"><%= v %></a><% } %></div>
<div class="card table-wrap"><table class="responsive"><thead><tr><th>Lớp</th><th>Giáo viên</th><th>Lịch</th><th>Học phí</th><th>Sĩ số</th><th>Tiến độ</th></tr></thead><tbody>
<% for (const c of list) { %><tr>
  <td data-l="Lớp"><a href="/classes/<%= c.id %>"><strong><%= c.name %></strong></a><div class="small muted"><%= c.subject_name || '' %><%= c.room_name ? ' · ' + c.room_name : '' %></div></td>
  <td data-l="GV"><%= c.teacher_name || '—' %></td><td data-l="Lịch" class="small"><%= c.schedule || '—' %></td>
  <td data-l="Học phí" class="small"><%= FEE_TYPES[c.fee_type] %> · <%= c.billing_timing === 'postpaid' ? 'thu cuối kỳ' : 'thu đầu kỳ' %><% if (!isTeacher) { %>: <%= vnd(c.fee_amount) %><%= c.fee_type === 'package' ? '/buổi' + (c.package_sessions && c.billing_timing !== 'postpaid' ? ', gói ' + c.package_sessions + ' buổi' : '') : c.fee_type === 'monthly' ? '/tháng' : '/khóa' %><% } %></td>
  <td data-l="Sĩ số"><%= c.active_count %><%= c.max_students ? '/' + c.max_students : '' %></td>
  <td data-l="Tiến độ" class="small"><%= c.done_count %>/<%= c.total_sessions || c.session_count %> buổi<%= c.total_sessions ? '' : ' (đã lên lịch)' %></td></tr><% } %>
<% if (!list.length) { %><tr><td colspan="6" class="muted">Chưa có lớp. <% if (can.manageClasses) { %><a href="/classes/new">Tạo lớp đầu tiên</a><% } %></td></tr><% } %>
</tbody></table></div>
