<!doctype html><html lang="vi"><head><meta charset="utf-8"><title><%= rc.code %></title>
<style>
  @page { size: A5; margin: 12mm; } body { font: 14px/1.5 "Times New Roman", serif; color: #000; max-width: 560px; margin: 20px auto; }
  .head { display: flex; gap: 12px; align-items: center; border-bottom: 1px solid #000; padding-bottom: 8px; } .head img { width: 60px; height: 60px; object-fit: contain; }
  h1 { text-align: center; font-size: 22px; margin: 14px 0 2px; letter-spacing: 1px; } .code { text-align: center; margin-bottom: 14px; }
  table { width: 100%; border-collapse: collapse; } td { padding: 5px 0; vertical-align: top; } td:first-child { width: 38%; }
  .amt { font-size: 18px; font-weight: bold; } .sign { display: flex; justify-content: space-between; margin-top: 30px; text-align: center; } .sign div { width: 45%; }
  .void { color: #c00; border: 2px solid #c00; text-align: center; font-weight: bold; padding: 4px; margin: 8px 0; }
  .foot { margin-top: 30px; font-size: 12px; font-style: italic; text-align: center; } @media print { .no-print { display: none; } }
</style></head><body>
<div class="no-print" style="text-align:right;margin-bottom:10px"><button onclick="window.print()">🖨 In / Lưu PDF</button></div>
<div class="head"><% if (center.logo_path) { %><img src="/logo" alt=""><% } %><div><strong style="font-size:16px"><%= center.center_name %></strong><br><%= center.center_address %><br><%= center.center_phone %> <%= center.center_email %></div></div>
<h1><%= center.receipt_title || 'PHIẾU THU' %></h1>
<div class="code">Số: <strong><%= rc.code %></strong> · Ngày <%= dmy(rc.paid_date) %></div>
<% if (rc.status === 'void') { %><div class="void">PHIẾU ĐÃ HỦY – <%= rc.void_reason %></div><% } %>
<table>
  <tr><td>Học sinh:</td><td><strong><%= rc.student_name %></strong> (<%= rc.student_code %>)</td></tr>
  <tr><td>Người nộp:</td><td><%= rc.payer_name || rc.parent_name || '' %></td></tr>
  <tr><td>Lớp:</td><td><%= rc.class_name || '—' %></td></tr>
  <tr><td>Nội dung / kỳ thu:</td><td><%= rc.kind === 'deposit' ? 'Đặt cọc / học phí trả trước' : 'Học phí ' + (rc.period_label || '') %></td></tr>
  <tr><td>Số tiền:</td><td class="amt"><%= vnd(rc.amount) %></td></tr>
  <tr><td>Hình thức:</td><td><%= METHODS[rc.method] %></td></tr>
  <% if (inv) { %><tr><td>Tình trạng khoản:</td><td>Phải thu <%= vnd(inv.amount) %> · đã đóng <%= vnd(inv.paid) %> · còn lại <%= vnd(inv.due) %></td></tr><% } %>
  <% if (rc.note) { %><tr><td>Ghi chú:</td><td><%= rc.note %></td></tr><% } %>
</table>
<div class="sign"><div>Người nộp tiền<br><br><br><br><%= rc.payer_name || '' %></div><div>Người thu tiền<br><br><br><br><%= rc.collector_name %></div></div>
<div class="foot"><%= center.receipt_footer %></div>
</body></html>
