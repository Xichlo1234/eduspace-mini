<div class="card" style="max-width:480px">
<h1>Đổi mật khẩu</h1>
<% if (user.must_change_password) { %><div class="alert warn">Vui lòng đặt mật khẩu riêng trước khi sử dụng.</div><% } %>
<% if (error) { %><div class="alert error"><%= error %></div><% } %>
<form method="post" class="stack"><%- include('partials/csrf') %>
  <div class="field"><label>Mật khẩu hiện tại</label><input type="password" name="current" required autocomplete="current-password"></div>
  <div class="field"><label>Mật khẩu mới</label><input type="password" name="password" required minlength="8" autocomplete="new-password"><span class="hint">Ít nhất 8 ký tự, có chữ và số.</span></div>
  <div class="field"><label>Nhập lại mật khẩu mới</label><input type="password" name="password2" required minlength="8" autocomplete="new-password"></div>
  <button class="btn primary">Lưu mật khẩu</button>
</form></div>
