{
  "name": "eduspace-mini",
  "version": "1.0.0",
  "description": "Ứng dụng web quản lý trung tâm đào tạo quy mô nhỏ (một cơ sở, dưới 200 học sinh)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/seed-demo.js && DATA_FILE=data/demo.db PORT=3001 node src/server.js",
    "seed:demo": "node scripts/seed-demo.js",
    "backup": "node scripts/backup.js",
    "test": "node --test test/*.test.js"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
