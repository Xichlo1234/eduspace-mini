{
  "name": "eduspace-mini",
  "version": "1.0.0",
  "description": "Ứng dụng web quản lý trung tâm đào tạo quy mô nhỏ (một cơ sở, dưới 200 học sinh)",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "demo": "node scripts/demo.js",
    "seed:demo": "node scripts/seed-demo.js",
    "backup": "node scripts/backup.js",
    "test": "node --test test/*.test.js",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "build:cf": "node scripts/build-cf.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "eslint-scope": "^9.1.2",
    "espree": "^11.2.0",
    "supertest": "^7.3.2",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
